{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SB-MS: start all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SB-MS: postgres",
        "SB-MS: discovery-server",
        "SB-MS: config-server",
        "SB-MS: product-service",
        "SB-MS: inventory-service :8091",
        "SB-MS: inventory-service :8092",
        "SB-MS: order-service",
        "SB-MS: api-gateway"
      ],
      "problemMatcher": [],
      "detail": "One Cursor terminal tab per service. Postgres, then Eureka, then Config Server, then the apps."
    },
    {
      "label": "SB-MS: postgres",
      "type": "shell",
      "command": "bash",
      "args": ["./scripts/dev-services.sh", "postgres"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "sb-ms-postgres",
        "pattern": { "regexp": "^SB-MS problem: (.*)$", "message": 1 },
        "background": {
          "activeOnStart": false,
          "beginsPattern": "SB-MS postgres starting",
          "endsPattern": "SB-MS postgres ready"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "SB-MS: discovery-server",
      "type": "shell",
      "command": "bash",
      "args": ["./scripts/dev-services.sh", "discovery-server"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "sb-ms-discovery",
        "pattern": { "regexp": "^SB-MS problem: (.*)$", "message": 1 },
        "background": {
          "activeOnStart": false,
          "beginsPattern": "SB-MS starting discovery-server",
          "endsPattern": "Started DiscoveryServerApplication|port .* is already in use"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": { "instanceLimit": 1 }
    },
