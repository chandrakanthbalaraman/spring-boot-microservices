{
  "info": {
    "_postman_id": "6914153e-914a-4704-b7c2-d1afe3f7aede",
    "name": "SB-MS Phase 01",
    "description": "Phase 1 local APIs: product-service :8081, inventory-service :8082.\n\nRun **Create product** first so `productId` is captured for inventory requests.\norder-service (:8083) has no controller yet — folder is a placeholder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "product-service",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Body is a JSON array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productServiceBaseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response has id and sku', () => {",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('sku');",
                  "});",
                  "pm.collectionVariables.set('productId', String(body.id));",
                  "pm.collectionVariables.set('productSku', body.sku);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"price\": 89.99,\n  \"sku\": \"SKU-{{$timestamp}}\"\n}"
            },
            "url": "{{productServiceBaseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Get product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Id matches path variable', () => {",
                  "  pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('productId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productServiceBaseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Get product by SKU",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('SKU matches', () => {",
                  "  pm.expect(pm.response.json().sku).to.eql(pm.collectionVariables.get('productSku'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productServiceBaseUrl}}/api/v1/products/sku/{{productSku}}"
          }
        },
        {
          "name": "Update product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Name was updated', () => {",
                  "  pm.expect(pm.response.json().name).to.include('updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard (updated)\",\n  \"price\": 79.99\n}"
            },
            "url": "{{productServiceBaseUrl}}/api/v1/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "inventory-service",
      "item": [
        {
          "name": "Create inventory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('productId matches', () => {",
                  "  pm.expect(String(pm.response.json().productId)).to.eql(pm.collectionVariables.get('productId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"availableQuantity\": 100\n}"
            },
            "url": "{{inventoryServiceBaseUrl}}/api/v1/inventories",
            "description": "Creates stock for `{{productId}}`. Duplicate productId is rejected."
          }
        },
        {
          "name": "Get inventory by productId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryServiceBaseUrl}}/api/v1/inventories/{{productId}}",
            "description": "Lookup by productId, not inventory row id."
          }
        },
        {
          "name": "Add stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/v1/inventories/{{productId}}/add-stock?quantity=10",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "v1", "inventories", "{{productId}}", "add-stock"],
              "query": [{ "key": "quantity", "value": "10" }]
            },
            "description": "Increments availableQuantity. quantity must be > 0."
          }
        },
        {
          "name": "Reserve stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('reservedQuantity increased', () => {",
                  "  pm.expect(pm.response.json().reservedQuantity).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/v1/inventories/{{productId}}/reserve-stock?quantity=2",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "v1", "inventories", "{{productId}}", "reserve-stock"],
              "query": [{ "key": "quantity", "value": "2" }]
            },
            "description": "Moves available → reserved. Fails if quantity > availableQuantity."
          }
        },
        {
          "name": "Release stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/v1/inventories/{{productId}}/release-stock?quantity=2",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "v1", "inventories", "{{productId}}", "release-stock"],
              "query": [{ "key": "quantity", "value": "2" }]
            },
            "description": "Moves reserved → available. Fails if quantity > reservedQuantity."
          }
        }
      ]
    },
    {
      "name": "order-service",
      "item": [
        {
          "name": "POST /orders (not implemented)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{orderServiceBaseUrl}}/api/v1/orders",
            "description": "Placeholder. order-service has DTOs + DB, but no controller yet. Expect 404 until POST /orders is implemented."
          }
        }
      ]
    },
    {
      "name": "cleanup",
      "item": [
        {
          "name": "Delete product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{productServiceBaseUrl}}/api/v1/products/{{productId}}",
            "description": "Runs last so inventory tests still have a productId."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "productServiceBaseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "inventoryServiceBaseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "orderServiceBaseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "productId",
      "value": "3"
    },
    {
      "key": "productSku",
      "value": "SKU-PM-1788992826"
    }
  ]
}
